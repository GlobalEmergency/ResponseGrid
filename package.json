{
  "name": "reliefhub",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev:infra": "docker compose up -d",
    "api:dev": "pnpm --filter api start:dev",
    "api:test": "pnpm --filter api test",
    "gen:api": "pnpm --filter api gen:openapi && pnpm --filter @reliefhub/api-client generate"
  },
  "pnpm": {
    "overrides": {
      "body-parser": "^2.4.0",
      "browserslist": "^4.28.7",
      "ioredis": "5.10.1",
      "js-yaml": "^4.3.2",
      "multer": "^2.5.0",
      "nanoid": "^3.3.18",
      "postcss": "^8.5.18",
      "proxy-addr": "^2.0.8",
      "source-map-js": "^1.2.2"
    }
  }
}
